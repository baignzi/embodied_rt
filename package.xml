<?xml version="1.0"?>
<package format="3">
  <name>embodied_rt</name>
  <version>1.0.0</version>
  <description>VLA模型实时推理与机械臂运动控制协同框架</description>
  <maintainer email="dev@example.com">EmbodiedRT Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- 可选依赖（MoveIt2完整模式） -->
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>moveit_resources_panda_description</exec_depend>

  <!-- 可选：真实VLA模型依赖 -->
  <exec_depend>python3-torch</exec_depend>
  <exec_depend>python3-transformers</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
